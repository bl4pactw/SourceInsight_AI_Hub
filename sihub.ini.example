; SI AI Hub 設定檔 —— 複製成 sihub.ini，放在 sihub.exe 同一目錄
; 每次觸發都會重新讀取，修改後不需重啟 hub。
; 本檔請只放 ASCII（Windows INI API 會以系統 ANSI 編碼讀取）；中文範本請寫在範本檔。

[general]
; 1 = 在 exe 目錄寫 sihub.log（除錯用）
log=0
; 範本檔：相對於 exe 目錄，或絕對路徑（UTF-8）
templates=sihub_templates.txt
; 1 = 顯示系統匣圖示（右鍵：編輯範本 / 設定 / log、開啟資料夾、結束）
tray_icon=1

[paths]
; SI 看到的 Windows 路徑前綴 -> VS Code Remote / Claude 看到的 Linux 路徑前綴
; 例：Z:\sdk\foo.c -> /home/bl4/work/sdk/foo.c
win_prefix=Z:\
linux_prefix=/home/bl4/work

[target]
; 預設送出目標：vscode（預填到 VS Code Claude）或 tmux（送進 tmux 裡的 Claude CLI 並送出）
; 範本可用 [標題] !tmux 或 [標題] !vscode 個別覆寫
default=vscode
; {prompt} 會被替換為 URL-encoded 的 prompt
uri=vscode://anthropic.claude-code/open?prompt={prompt}
; 1 = 同時把 prompt 放進剪貼簿（URI 預填失敗時可直接 Ctrl+V）
copy_to_clipboard=1
; 1 = 不真的開 URI，只寫 log（搭配 log=1 驗證設定）
dry_run=0

[tmux]
; 使用哪條 SSH 連線（不在清單中會自動加入並連線）
;connection=user@host
; tmux session 名稱；在遠端先執行：tmux new -A -s sihub claude
session=sihub
; 1 = 貼上後按 Enter 送出；0 = 只貼上，讓你在終端機確認後再送
submit=1
; 貼上與 Enter 之間的等待（毫秒）
submit_delay_ms=300
; 安全檢查：視窗中執行的程式必須是其中之一才送出（避免貼進 bash 被當成指令執行）
allowed_commands=claude,node
; 1 = 送出後等待 Claude 回覆完成，存成 exe 旁的 last_reply.md（需先在 Connections 選單執行 Install reply hook）
read_reply=1
; 最多等待秒數 / 輪詢間隔（毫秒）
reply_timeout_s=900
reply_poll_ms=2000

[viewer]
; 1 = 收到回覆時自動開啟檢視器（不搶焦點）；0 = 只跳通知
auto_open=1
; 1 = 檢視器可按 F12 開發者工具（修改 viewer.html 時用）
devtools=0
; 視窗位置與大小由 hub 自動寫入：x,y,寬,高,是否最大化
;placement=

[connections]
; 由系統匣 Connections → Connect to... 自動維護，也可手動編輯（不存密碼）
;conn1=user@host
;conn2=user@host:2222

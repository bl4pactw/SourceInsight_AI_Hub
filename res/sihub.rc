#include <windows.h>
#include "resource.h"

IDI_SIHUB ICON "sihub.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sihub.manifest"

IDR_VIEWER_HTML RCDATA "viewer.html"

IDD_PROMPT DIALOGEX 0, 0, 260, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "SI AI Hub"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PROMPT_MESSAGE, 8, 8, 244, 34
    EDITTEXT        IDC_PROMPT_EDIT, 8, 46, 244, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 146, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 202, 70, 50, 14
END
